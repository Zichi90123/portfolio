---
import Base from '../layouts/Base.astro';
import { LINKS } from '../consts';

// Personal data from the CV (phone, address, date of birth, photo) is deliberately left out.
const experience = [
  {
    period: '2020 – oggi',
    role: 'Principal software engineer',
    company: 'Itauros, Torino',
    intro:
      'Guido un team di 5 sviluppatori: raccolta dei requisiti con clienti e stakeholder, architettura, code review e cerimonie Agile. I progetti principali:',
    projects: [
      {
        name: 'Portale di firma digitale · software house italiana',
        period: '2022 – oggi',
        text: 'Ho avviato e guidato la riscrittura dei due frontend React (console per firmatari e certificati, app di firma per l’utente finale) su microservizi Spring Boot: firma grafometrica e biometrica, OTP, firma qualificata CAdES, notifiche in tempo reale. Oltre 100.000 firme al mese.',
      },
      {
        name: 'Ferie e riposi del personale ferroviario · gruppo del trasporto ferroviario',
        period: '2026 – oggi',
        text: 'Un motore di simulazione in Python che genera i riposi del mese rispettando vincoli come il personale minimo per sede; due microservizi Go in architettura esagonale su Kubernetes, con OpenTelemetry; una PWA in React 19 con accesso tramite Azure AD.',
      },
      {
        name: 'Piattaforma e-commerce · gruppo italiano del retail',
        period: '2026 – oggi',
        text: 'Backend Java e Spring Boot: migrazione da AWS SDK v1 a v2 per S3 e SES, un nuovo dominio “Food Service”, rilasci su Kubernetes (GKE).',
      },
      {
        name: 'Portale di provisioning · grande banca italiana',
        period: '2019 – 2022',
        text: 'Technical lead di un portale self-service in Angular e Spring Boot per creare VM, microservizi e storage, orchestrato con Jenkins: tempi di attesa passati da giorni a minuti.',
      },
      {
        name: 'App fedeltà · marchio internazionale del food & beverage',
        period: '2020 – 2022',
        text: 'Refactoring e nuove funzioni di un’app React Native usata in 6 paesi, con backend serverless su Azure Functions e infrastruttura in Terraform. Valutazione sugli store da 3,2 a 4,5.',
      },
    ],
  },
  {
    period: '2018 – 2020',
    role: 'Full stack developer',
    company: 'e.MAGINE, Torino',
    intro:
      'Coordinavo 5 sviluppatori. Tra i progetti, un sistema di assistenza remota per tecnici sul campo: audio e video in tempo reale con WebRTC, app desktop in Electron e pannello Angular per gli esperti.',
  },
  {
    period: '2015 – 2018',
    role: 'Primi lavori',
    company: 'DM Packaging Group, Erasmus Torino',
    intro: 'Applicazioni web interne per un’azienda di packaging e il sito di un’associazione.',
  },
];

const skills = [
  { area: 'Frontend', items: 'React, React Native, Angular, Next.js, TypeScript, Tailwind CSS' },
  { area: 'Backend', items: 'Node.js (NestJS, Express), Java e Spring Boot, Go, Python' },
  { area: 'Dati', items: 'PostgreSQL, MongoDB, Redis, MySQL, Firestore, Cosmos DB' },
  {
    area: 'Cloud e DevOps',
    items:
      'AWS (Lambda, S3, EventBridge), Azure (Functions, AD), Kubernetes e Helm, Terraform, Docker, Jenkins, GitHub Actions, OpenTelemetry',
  },
  { area: 'In più', items: 'WebRTC, firma digitale, PWA e notifiche push, microservizi ed eventi' },
];

const h2 = 'mt-12 text-xl font-semibold text-slate-900 dark:text-white';
const muted = 'text-sm text-slate-600 dark:text-slate-400';
const link = 'text-accent dark:text-accent-light underline';
---

<Base
  title="Chi sono"
  description="Andrea Zichittella, senior full stack engineer a Torino: percorso, progetti e competenze."
>
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Chi sono</h1>

  <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed">
    <p>
      Sono Andrea, senior full stack engineer a Torino. Dal 2017 progetto e sviluppo piattaforme web e mobile,
      dal frontend ai microservizi fino al rilascio, e da diversi anni guido piccoli team.
    </p>
    <p>
      Fuori dal lavoro costruisco progetti completi da solo: parto da un documento dei requisiti, scelgo uno
      stack che costi quasi zero e arrivo a un’app online con test, CI e monitoraggio. Sono quelli che trovi
      in <a href="/progetti" class={link}>Progetti</a>.
    </p>
  </div>

  <section aria-labelledby="percorso">
    <h2 id="percorso" class={h2}>Percorso</h2>
    <ol class="mt-6 space-y-8">
      {
        experience.map((job) => (
          <li>
            <p class={muted}>{job.period}</p>
            <h3 class="mt-1 font-semibold text-slate-900 dark:text-white">
              {job.role} · {job.company}
            </h3>
            <p class="mt-2 max-w-2xl leading-relaxed">{job.intro}</p>
            {job.projects && (
              <ul class="mt-4 space-y-4 border-l border-slate-200 pl-4 dark:border-slate-800">
                {job.projects.map((p) => (
                  <li>
                    <p class="font-medium text-slate-900 dark:text-white">
                      {p.name} <span class={muted}>· {p.period}</span>
                    </p>
                    <p class="mt-1 max-w-2xl leading-relaxed">{p.text}</p>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="insegnamento">
    <h2 id="insegnamento" class={h2}>Insegnamento</h2>
    <p class="mt-4 max-w-2xl leading-relaxed">
      Dal 2025 sono docente alla Fondazione ITS ICT: corsi su Node.js (event loop, ecosistema npm,
      scalabilità del backend) e sui database NoSQL, con esercitazioni su casi reali e revisioni
      dell’architettura dei progetti degli studenti.
    </p>
  </section>

  <section aria-labelledby="competenze">
    <h2 id="competenze" class={h2}>Competenze</h2>
    <dl class="mt-4 max-w-2xl space-y-3">
      {
        skills.map((s) => (
          <div class="sm:flex sm:gap-4">
            <dt class="font-medium text-slate-900 sm:w-36 sm:shrink-0 dark:text-white">{s.area}</dt>
            <dd>{s.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="formazione">
    <h2 id="formazione" class={h2}>Formazione</h2>
    <ul class="mt-4 max-w-2xl space-y-2">
      <li>Laurea magistrale in Informatica · Politecnico di Torino</li>
      <li>Laurea triennale in Informatica · Università di Parma</li>
      <li>Google Project Management (Coursera, 2021)</li>
      <li>Inglese: livello C1</li>
    </ul>
  </section>

  <section aria-labelledby="contatti">
    <h2 id="contatti" class={h2}>Contatti</h2>
    <p class="mt-4">
      Il codice dei progetti è su <a href={LINKS.github} class={link}>GitHub</a>.
      {LINKS.linkedin && <> Mi trovi anche su <a href={LINKS.linkedin} class={link}>LinkedIn</a>.</>}
      {LINKS.email && <> Per scrivermi: <a href={`mailto:${LINKS.email}`} class={link}>{LINKS.email}</a>.</>}
    </p>
  </section>
</Base>
