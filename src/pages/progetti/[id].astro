---
import ProjectPage from '../../views/ProjectPage.astro';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('it');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}
---

<ProjectPage project={Astro.props.project} lang="it" />
