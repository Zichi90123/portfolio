---
import '../styles/global.css';
import { LINKS, SITE } from '../consts';
import { ROUTES, t, type Lang } from '../i18n';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Same page in the other language (public path). Defaults to that language's home. */
  alternate?: string;
  /** Open Graph image path, built by src/pages/og/[...slug].png.ts. */
  image?: string;
  imageAlt?: string;
}

const { lang = 'it', title, alternate, imageAlt } = Astro.props;
const ui = t(lang);
const other: Lang = lang === 'it' ? 'en' : 'it';
const description = Astro.props.description ?? ui.description;
const image = Astro.props.image ?? (lang === 'it' ? '/og/default.png' : '/og/en/default.png');
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${ui.portfolio}`;
// Pages are built as name.html (build.format: 'file') but served without the extension:
// canonical, og:url, hreflang and the active menu item use the public path.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const otherPath = alternate ?? ROUTES.home[other];
const hreflang = { [lang]: canonical, [other]: new URL(otherPath, Astro.site) } as Record<Lang, URL>;
const ogImage = new URL(image, Astro.site);
const ogAlt = imageAlt ?? `${title ?? SITE.name}: ${description}`;
const home = ROUTES.home[lang];
const nav = [
  { href: home, label: ui.nav.home },
  { href: ROUTES.projects[lang], label: ui.nav.projects },
  { href: ROUTES.articles[lang], label: ui.nav.articles },
  { href: ROUTES.about[lang], label: ui.nav.about },
];
const isCurrent = (href: string) => (href === home ? path === home : path.startsWith(href));
const linkClass = 'hover:text-accent dark:hover:text-accent-light';
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={hreflang.it} />
    <link rel="alternate" hreflang="en" href={hreflang.en} />
    <link rel="alternate" hreflang="x-default" href={hreflang.it} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={ui.rssTitle} href={ROUTES.rss[lang]} />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:locale:alternate" content={t(other).ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    <!-- Applies the saved or system theme before first paint (no flash). -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body
    class="flex min-h-dvh flex-col bg-white font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200"
  >
    <a
      href="#contenuto"
      class="sr-only rounded bg-slate-900 px-3 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
      >{ui.skip}</a
    >
    <header class="border-b border-slate-200 dark:border-slate-800">
      <nav
        aria-label={ui.navLabel}
        class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4"
      >
        <!-- Phone: name, language and theme on the first row, links below. From sm up: one row. -->
        <a href={home} class="mr-auto font-semibold text-slate-900 dark:text-white">{SITE.name}</a>
        <ul class="order-last flex w-full gap-5 text-sm sm:order-none sm:w-auto">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class="hover:text-accent aria-[current=page]:text-accent dark:hover:text-accent-light dark:aria-[current=page]:text-accent-light"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-2">
          <a
            href={otherPath}
            hreflang={other}
            lang={other}
            aria-label={ui.switchLabel}
            title={ui.switchTo}
            class="rounded-md border border-slate-300 px-2 py-1 text-xs font-semibold tracking-wide hover:border-slate-500 dark:border-slate-700 dark:hover:border-slate-500"
            >{ui.switchShort}</a
          >
          <ThemeToggle label={ui.themeLabel} />
        </div>
      </nav>
    </header>

    <main id="contenuto" class="mx-auto w-full max-w-4xl flex-1 px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200 text-sm dark:border-slate-800">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-x-6 gap-y-2 px-4 py-6">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <a href={LINKS.github} class={linkClass}>GitHub</a>
        {LINKS.linkedin && <a href={LINKS.linkedin} class={linkClass}>LinkedIn</a>}
        {LINKS.email && <a href={`mailto:${LINKS.email}`} class={linkClass}>Email</a>}
      </div>
    </footer>
  </body>
</html>
