<button
  id="theme-toggle"
  type="button"
  aria-label="Cambia tema chiaro/scuro"
  class="rounded-md border border-slate-300 px-2 py-1 text-sm hover:border-slate-500 dark:border-slate-700 dark:hover:border-slate-500"
>
  <span class="dark:hidden" aria-hidden="true">☾</span>
  <span class="hidden dark:inline" aria-hidden="true">☀</span>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      // Storage unavailable (private mode): the choice lasts for this page only.
    }
  });
</script>
