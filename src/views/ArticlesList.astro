---
import Base from '../layouts/Base.astro';
import { articlePath, ROUTES, t, type Lang } from '../i18n';
import { formatDate, getArticles } from '../lib/articles';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const articles = await getArticles(lang);
---

<Base
  lang={lang}
  title={ui.articlesTitle}
  description={ui.articlesDescription}
  alternate={ROUTES.articles[lang === 'it' ? 'en' : 'it']}
>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">{ui.articlesTitle}</h1>
    <a href={ROUTES.rss[lang]} class="text-accent dark:text-accent-light text-sm underline">{ui.rssLabel}</a>
  </div>
  <p class="mt-3 max-w-2xl">{ui.articlesDescription}</p>

  {
    articles.length === 0 ? (
      <p class="mt-8">{ui.noArticles}</p>
    ) : (
      <ol class="mt-8 space-y-8">
        {articles.map((a) => (
          <li class="relative max-w-2xl">
            <p class="text-sm text-slate-600 dark:text-slate-400">
              <time datetime={a.data.date.toISOString().slice(0, 10)}>{formatDate(a.data.date, ui.dateLocale)}</time>
              {' · '}
              {ui.readingTime(a.minutes)}
              {a.data.draft && ` · ${ui.draft}`}
            </p>
            <h2 class="mt-1 text-xl font-semibold text-slate-900 dark:text-white">
              <a href={articlePath(a.id, lang)} class="hover:text-accent dark:hover:text-accent-light after:absolute after:inset-0">
                {a.data.title}
              </a>
            </h2>
            <p class="mt-2">{a.data.description}</p>
          </li>
        ))}
      </ol>
    )
  }
</Base>
