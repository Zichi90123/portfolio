---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { CATEGORIES } from '../consts';
import { ROUTES, t, type Lang } from '../i18n';
import { getProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const projects = await getProjects(lang);
const categories = CATEGORIES.filter((c) => projects.some((p) => p.data.category === c));
const techs = [...new Set(projects.flatMap((p) => p.data.tech))].sort((a, b) => a.localeCompare(b));
const selectClass =
  'mt-1 block rounded-md border border-slate-300 bg-white px-2 py-1 dark:border-slate-700 dark:bg-slate-900';
---

<Base
  lang={lang}
  title={ui.projectsTitle}
  description={ui.projectsDescription}
  alternate={ROUTES.projects[lang === 'it' ? 'en' : 'it']}
>
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">{ui.projectsTitle}</h1>

  {
    projects.length === 0 ? (
      <p class="mt-6">{ui.noProjects}</p>
    ) : (
      <>
        {/* Progressive enhancement: without JavaScript every card stays visible. */}
        <form id="filtri" class="mt-6 flex flex-wrap gap-4 text-sm" aria-label={ui.filtersLabel}>
          <label>
            {ui.category}
            <select name="categoria" class={selectClass}>
              <option value="">{ui.all}</option>
              {categories.map((c) => (
                <option value={c}>{ui.categories[c]}</option>
              ))}
            </select>
          </label>
          <label>
            {ui.technology}
            <select name="tecnologia" class={selectClass}>
              <option value="">{ui.all}</option>
              {techs.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </label>
        </form>
        <p id="nessun-risultato" class="mt-6 hidden" role="status">
          {ui.noResults}
        </p>
        <div id="griglia" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} lang={lang} />
          ))}
        </div>
      </>
    )
  }
</Base>

<script>
  const form = document.getElementById('filtri') as HTMLFormElement | null;
  const cards = document.querySelectorAll<HTMLElement>('#griglia > article');
  const empty = document.getElementById('nessun-risultato');

  function apply() {
    if (!form) return;
    const data = new FormData(form);
    const category = String(data.get('categoria') ?? '');
    const tech = String(data.get('tecnologia') ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const ok =
        (!category || card.dataset.category === category) &&
        (!tech || (card.dataset.tech ?? '').split('|').includes(tech));
      card.hidden = !ok;
      if (ok) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  }

  form?.addEventListener('change', apply);
</script>
